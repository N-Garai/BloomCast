%% BloomCast architecture — Mermaid flowchart.
%% Rendered by GitHub automatically when referenced from markdown.
%% ASCII-only labels: some renderers choke on unicode arrows in node text.

flowchart TD
    subgraph OFFLINE["Offline: scheduled + manual (never in the request path)"]
        direction TB
        GH["GitHub Actions cron<br/>02:00 UTC, free tier"]
        OM_S["Open-Meteo<br/>forecast + archive"]
        PC["Planetary Computer<br/>Sentinel-2 L2A, anonymous STAC"]
        GH --> OM_S & PC
        OM_S & PC --> ING["src/data/ingested-features.json"]
        ING --> CLIMGEN["scripts/generate_climatology.py"]
        CLIMGEN --> CLIM["src/data/climatology.json<br/>measured seasonal means, 19 pilots"]
        ING --> SEEDGEN["scripts/generate_seed.py"]
        SEEDGEN --> SEED["src/data/seed/*.json<br/>forecasts, sandbox, replay, scorecard"]
        CAML["CAML .sb labels<br/>doi:10.5067/SeaBASS/CAML/DATA001"]
        WCACHE["weather_cache.csv<br/>beside the labels, not in git"]
        CAML & WCACHE --> EXPORT["scripts/export_artifacts.py<br/>manual, local"]
        EXPORT --> ART["src/backend/ml/artifacts/<br/>v2.1.0-real-labels, tick-tick-bloom"]
    end

    subgraph SERVE["Request path: one Render Docker service (free tier)"]
        direction TB
        USER["Viewer lat/lon<br/>dashboard, map, explorer"]
        USER --> INF["GET /v1/infer or /v1/explore"]
        INF --> OM_L["Open-Meteo live<br/>2 calls, 15-min TTL cache"]
        INF --> CLIM
        INF --> STAT["Pilot statics<br/>per-pilot lookup"]
        INF --> CIT["Citizen DB<br/>SQLite default, Postgres via DATABASE_URL"]
        OM_L & CLIM & STAT & CIT --> ROW["Live 32-dim row<br/>+ heuristic score"]
        ROW --> ROUTE{"Spectral prior present<br/>+ real-label artifacts?"}
        ART -.-> ROUTE
        ROUTE -- yes --> FULL["full-32 tier<br/>LightGBM + CNN + ensemble"]
        ROUTE -- no --> WO["weather-only tier<br/>real-label variant"]
        FULL & WO --> RESP["Response<br/>tier, input_availability,<br/>provenance, caveats, cache"]
        ROW --> HEUR["live-heuristic-nowcast<br/>always available"]
    end

    subgraph LOOP["Citizen + alert loops"]
        direction TB
        REP["Citizen report"] --> Q["Steward queue<br/>approve / reject"]
        Q --> W["Training sample weights<br/>capped at 15%, published share"]
        Q --> CIT
        SUB["Threshold subscription"] --> CHECK["/v1/alerts/check<br/>60s poll, page open"]
        CHECK --> NOTIF["Browser notification<br/>+ ntfy phone channel"]
    end

    SEED --> SERVE
    RESP --> LOOP
    W -.-> EXPORT
