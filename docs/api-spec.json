                }
              }
            }
          }
        }
      }
    },
    "/v1/infer": {
      "get": {
        "summary": "Infer",
        "description": "Realtime assessment for any point on Earth (v2 M1).\n\nLive weather in 2\u20134 s, scored on the spot and cached for 15 minutes per\n~110 m cell. Carries ``provenance``, ``cache`` and ``caveats`` so no number\ncan be read without its origin and its staleness.",
        "operationId": "infer_v1_infer_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
