    "/v1/explore": {
      "get": {
        "summary": "Explore",
        "description": "Live weather-only assessment for ANY coordinates.\n\nFetches realtime Open-Meteo data at request time (no nightly job\ninvolved) and scores wash-off risk with the StreamFlush heuristic.\nThis is a live nowcast, not a calibrated forecast \u2014 pilot waterbodies\n(see nearest_waterbody) carry the full 3\u20137 day model outlook.",
        "operationId": "explore_v1_explore_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "title": "Lat"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "title": "Lon"
            }
