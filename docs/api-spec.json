    "/v1/infer/batch": {
      "post": {
        "summary": "Infer Batch",
        "description": "Assess up to 50 points in one request (v2 M4).\n\nPer-IP budget keeps one client from spending the shared upstream quota;\nper-location failures come back in ``errors`` instead of failing the batch.",
        "operationId": "infer_batch_v1_infer_batch_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
