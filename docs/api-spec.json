                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/infer/stream": {
      "get": {
        "summary": "Infer Stream",
        "description": "Server-sent progressive assessment: cached hit \u2192 immediate, else staged.\n\nFirst frame (\"status\") is written before any upstream call, so the UI can\npaint inside the 300 ms budget instead of waiting on the weather window.",
        "operationId": "infer_stream_v1_infer_stream_get",
