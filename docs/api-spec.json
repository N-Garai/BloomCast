    "/v1/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness + honest model status (v2 M-K1).\n\n``model.status`` is ``loaded`` only when the exported artifacts passed the\nfeature-compatibility check; otherwise ``fallback`` with the reason. A\ngreen health check that hides a missing model is worse than a red one.\n\nHEAD is answered explicitly (headers only): container platforms probe\nwith HEAD during port detection, and a 405 there stalls the deploy\nbefore health checks ever run.",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      },
      "head": {
        "summary": "Health",
